# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth redirect URI (must match an "Authorized redirect URI" in Google Cloud Console)
VITE_GOOGLE_REDIRECT_URI=https://your-domain.com/auth/callback

# NOTE: do NOT add VITE_API_URL. Dev uses the Vite proxy for /api and production uses
# the same origin; an absolute URL would break the Telegram mini app and the website.
