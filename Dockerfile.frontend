# Frontend Dockerfile
#
# npm workspaces monorepo: the lockfile lives in the repo root, so the build installs
# from the root and builds the `frontend` workspace. The Vite build works on any domain
# (the app calls its own origin for `/api`), so the same bundle serves the website and
# the Telegram mini app.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/

RUN npm ci && npm cache clean --force

COPY frontend/ ./frontend/

RUN npm run build --workspace=frontend

# Production stage with Nginx
FROM nginx:alpine

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built static files
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# The nginx:alpine image already ships an `nginx` user and group (uid/gid 101), so we
# reuse them instead of creating duplicates (creating them fails with "group in use").
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

# Switch to non-root user
USER nginx

# Expose port
EXPOSE 8080

# Health check: /healthz is the plain-text probe; /health serves the SPA status page
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/healthz || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
