# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=uzbek_wars

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment System Configuration (for donations)
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Frontend URL (for CORS)
# Development
FRONTEND_URL=http://localhost:5173
# Production (aaPanel proxies uzbekwars.top -> localhost:3060)
# FRONTEND_URL=https://uzbekwars.top

# Docker Proxy Port
DOCKER_PROXY_PORT=3060

# Development Login (only works in development mode)
DEV_USERNAME=developer
DEV_PASSWORD=dev123456
