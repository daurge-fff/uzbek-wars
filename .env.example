# ============================================
# PRODUCTION DEPLOYMENT INSTRUCTIONS
# ============================================
# 
# 1. Update these variables for production:
#    - NODE_ENV=production
#    - FRONTEND_URL=https://uzbekwars.top
#    - MONGODB_URI (production database)
#    - JWT_SECRET (strong secret)
#    - GOOGLE_CLIENT_ID (for uzbekwars.top)
#    - GOOGLE_CLIENT_SECRET
#    - TELEGRAM_BOT_TOKEN
#
# 2. Run seed script ONCE on first deployment:
#    cd backend && npm run seed
#
# 3. Build and start containers:
#    ./rebuild.sh
#
# 4. aaPanel will proxy uzbekwars.top -> localhost:3060
#
# ============================================

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=uzbek_wars

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
# IMPORTANT: Generate a strong secret for production!
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment System Configuration (for donations)
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Frontend URL (for CORS)
# Production
FRONTEND_URL=https://uzbekwars.top
# Development (uncomment for local dev)
# FRONTEND_URL=http://localhost:5173

# Docker Proxy Port
DOCKER_PROXY_PORT=3060

# Development Login (only works in development mode)
DEV_USERNAME=developer
DEV_PASSWORD=dev123456

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_TELEGRAM_ID=1443725382
