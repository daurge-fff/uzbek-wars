# Backend Dockerfile
#
# This repo is an npm **workspaces** monorepo: the only lockfile is in the repo root
# (`package-lock.json`), there are none inside `backend/`. The image therefore installs
# from the root and builds the `backend` workspace.
#
# Stages:
#   builder  - full deps (tsc is a devDependency) -> backend/dist
#   prod-deps- production dependencies only
#   runtime  - the actual image, also used by `docker compose --profile tools` for
#              one-off tasks (seeds, bot setup) through the `builder` stage

FROM node:20-alpine AS builder

WORKDIR /app

# Workspace manifests must be present before `npm ci` (it needs the root lockfile)
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN npm ci && npm cache clean --force

COPY backend/ ./backend/

# TypeScript build -> /app/backend/dist
RUN npm run build --workspace=backend

FROM node:20-alpine AS prod-deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN npm ci --omit=dev --workspace=backend && npm cache clean --force

FROM node:20-alpine AS runtime

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Production dependencies + compiled output
COPY --from=prod-deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/backend/dist ./backend/dist
COPY --from=builder --chown=nodejs:nodejs /app/backend/package.json ./backend/package.json
COPY --chown=nodejs:nodejs package.json package-lock.json ./

WORKDIR /app/backend

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start application
CMD ["node", "dist/index.js"]
